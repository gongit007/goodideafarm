# Public site URL (no trailing slash). Used for sitemap, canonical, OG tags.
# Until you buy a custom domain, use the Vercel URL:
VITE_SITE_URL=https://goodideafarm.vercel.app

# Admin password for /admin and letter API (required on Vercel production)
ADMIN_KEY=change-me-to-a-strong-secret

# Letter notification (optional — Resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=
RESEND_FROM=Good Idea Farm <onboarding@resend.dev>
